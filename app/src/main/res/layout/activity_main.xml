<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp" android:gravity="center_vertical">
        <Spinner android:id="@+id/spinnerLibro" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="2" />
        <Spinner android:id="@+id/spinnerCapitulo" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="2dp" />
        <ImageButton android:id="@+id/btnFavoritos" android:layout_width="38dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Favoritos" android:src="@android:drawable/btn_star_big_on" />
        <ImageButton android:id="@+id/btnConcordancia" android:layout_width="38dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Concordancia" android:src="@android:drawable/ic_menu_search" />
        <ImageButton android:id="@+id/btnSettings" android:layout_width="38dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Ajustes" android:src="@android:drawable/ic_menu_preferences" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerVersiculos" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:clipToPadding="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/tvEstadoLectura" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Toca Play para escuchar · Mantén pulsado un versículo para guardar o compartir" android:textSize="11sp" android:paddingBottom="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <Button android:id="@+id/btnAnterior" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏮ Ant" />
            <Button android:id="@+id/btnPlayPause" android:layout_width="140dp" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="▶ Play" />
            <Button android:id="@+id/btnSiguiente" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sig ⏭" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>